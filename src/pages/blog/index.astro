---
import Layout from "../../layouts/BaseLayout.astro";
const allPosts = Object.values(import.meta.glob("./*.md", { eager: true }));
---

<Layout pageTitle="Blog">
  <p>Building a blog</p>
  <ul>
    {
      allPosts.map((post: any) => (
        <li>
          <a href={post.url}>{post.frontmatter.title}</a>
        </li>
      ))
    }
  </ul>
</Layout>
